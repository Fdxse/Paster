<Window x:Class="Paster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paster" Height="680" Width="1200" MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Shared look for the four setup editors: monospace, multi-line, no wrapping. -->
        <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="False" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <!-- Section headers. -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Red error text shown under an editor when it has soft errors. -->
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftErrorTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="MaxHeight" Value="60" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <!--
            The clipboard buttons. A custom template is used so that the "used" and "error"
            colors always show (the default Windows button template ignores Background on hover).
            Used buttons stay clickable on purpose: Ctrl+click has to reach them to re-enable them.
        -->
        <Style x:Key="ClipboardButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#FFF4F6FA" />
            <Setter Property="BorderBrush" Value="#FFB8C2D6" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF3B6FD8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFDCE6FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Soft error: light red background. -->
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SoftErrorBrush}" />
                </DataTrigger>
                <!-- Already copied: greyed out so it looks disabled. -->
                <DataTrigger Binding="{Binding IsUsed}" Value="True">
                    <Setter Property="Background" Value="#FFE6E6E6" />
                    <Setter Property="Foreground" Value="#FF9A9A9A" />
                    <Setter Property="BorderBrush" Value="#FFD0D0D0" />
                    <Setter Property="Cursor" Value="Arrow" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Background="#FFF0F0F0" BorderBrush="#FFD0D0D0" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="True">
                <!-- Keeps the window above all other windows. Remembered in config.json. -->
                <CheckBox x:Name="AlwaysOnTopCheckBox" DockPanel.Dock="Right" Content="Always on top"
                          VerticalAlignment="Center" Margin="0,0,12,0"
                          Checked="AlwaysOnTopCheckBox_Changed" Unchecked="AlwaysOnTopCheckBox_Changed"
                          ToolTip="Keep Paster above other windows so it doesn't get hidden" />
                <!-- Mode switch: Setup shows the editors, Action shows only the tables and buttons. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <RadioButton x:Name="SetupModeRadioButton" GroupName="Mode" Content="Setup" Padding="14,3"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Checked="ModeRadioButton_Checked"
                                 ToolTip="Edit the table list, variables, joiners and button templates" />
                    <RadioButton x:Name="ActionModeRadioButton" GroupName="Mode" Content="Action" Padding="14,3"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Checked="ModeRadioButton_Checked"
                                 ToolTip="Hide the editors and just use the buttons" />
                </StackPanel>
                <Button x:Name="ResetUsedButton" DockPanel.Dock="Right" Content="Reset buttons" Padding="12,3" Margin="0,0,8,0"
                        Click="ResetUsedButton_Click"
                        ToolTip="Make every button for the selected table clickable again" />
                <!-- Setup files: keep different setups as separate JSON files. -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,0">
                    <Button Content="Open..." Padding="10,3" Margin="0,0,4,0" Click="OpenSetupButton_Click"
                            ToolTip="Open a saved setup (Ctrl+O)" />
                    <Button Content="Save" Padding="10,3" Margin="0,0,4,0" Click="SaveSetupButton_Click"
                            ToolTip="Save the setup to its file (Ctrl+S)" />
                    <Button Content="Save as..." Padding="10,3" Click="SaveSetupAsButton_Click"
                            ToolTip="Save the setup to a new file (Ctrl+Shift+S)" />
                </StackPanel>
                <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Foreground="#FF505050"
                           TextTrimming="CharacterEllipsis"
                           Text="Click a button to copy. Ctrl+click a greyed-out button to enable it again." />
            </DockPanel>
        </Border>

        <!-- Bottom: action log, only shown in Action mode. -->
        <Border x:Name="ActionLogPanel" DockPanel.Dock="Bottom" Height="160" Visibility="Collapsed"
                BorderBrush="#FFD0D0D0" BorderThickness="0,1,0,0" Padding="8,6">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Open log folder" Padding="10,2" Click="OpenLogFolderButton_Click"
                            ToolTip="Show the daily log files in Explorer" />
                    <Button DockPanel.Dock="Right" Content="Clear" Padding="10,2" Margin="0,0,6,0" Click="ClearLogButton_Click"
                            ToolTip="Clear this list (the log files are kept)" />
                    <TextBlock Text="Action log" Style="{StaticResource HeaderTextStyle}" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="ActionLogListBox" FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="120" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition x:Name="SetupSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="SetupColumn" Width="420" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Left: table list -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Tables" Style="{StaticResource HeaderTextStyle}" />
                <ListBox x:Name="TableListBox" SelectionChanged="TableListBox_SelectionChanged"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,3" />
                            <Setter Property="ToolTip" Value="{Binding ErrorText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SoftErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Foreground="#FF808080" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding TableName}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Middle: buttons for the selected table -->
            <DockPanel Grid.Column="2">
                <TextBlock x:Name="SelectedTableHeader" DockPanel.Dock="Top" Text="Buttons" Style="{StaticResource HeaderTextStyle}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ButtonItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ClipboardButtonStyle}"
                                        Click="ClipboardButton_Click"
                                        ToolTip="{Binding ToolTipText}">
                                    <TextBlock Text="{Binding RenderedText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter x:Name="SetupGridSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right: setup editors. Every keystroke updates the buttons immediately. -->
            <Grid x:Name="SetupPanel" Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Table list   (Name; var=value; ...)" Style="{StaticResource HeaderTextStyle}" />
                <TextBox Grid.Row="1" x:Name="TablesTextBox" Style="{StaticResource EditorTextBoxStyle}" TextChanged="SetupEditor_TextChanged" />
                <TextBlock Grid.Row="2" x:Name="TablesErrorText" Style="{StaticResource ErrorTextStyle}" />

                <TextBlock Grid.Row="3" Text="Global variables   (name=value)" Style="{StaticResource HeaderTextStyle}" Margin="0,8,0,4" />
                <TextBox Grid.Row="4" x:Name="VariablesTextBox" Style="{StaticResource EditorTextBoxStyle}" TextChanged="SetupEditor_TextChanged" />
                <TextBlock Grid.Row="5" x:Name="VariablesErrorText" Style="{StaticResource ErrorTextStyle}" />

                <TextBlock Grid.Row="6" Text="Joiners   (name=template with {variables})" Style="{StaticResource HeaderTextStyle}" Margin="0,8,0,4" />
                <TextBox Grid.Row="7" x:Name="JoinersTextBox" Style="{StaticResource EditorTextBoxStyle}" TextChanged="SetupEditor_TextChanged" />
                <TextBlock Grid.Row="8" x:Name="JoinersErrorText" Style="{StaticResource ErrorTextStyle}" />

                <TextBlock Grid.Row="9" Text="Buttons   (one template per line, {name:transform})" Style="{StaticResource HeaderTextStyle}" Margin="0,8,0,4" />
                <TextBox Grid.Row="10" x:Name="ButtonsTextBox" Style="{StaticResource EditorTextBoxStyle}" TextChanged="SetupEditor_TextChanged" />
                <TextBlock Grid.Row="11" x:Name="ButtonsErrorText" Style="{StaticResource ErrorTextStyle}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
