<Window x:Class="Paster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Paster" Height="680" Width="1200" MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        AllowDrop="True" PreviewDragOver="Window_DragOver" PreviewDrop="Window_Drop">

    <Window.Resources>
        <!-- Shared look for the five setup editors: monospace, multi-line, no wrapping. -->
        <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="False" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <!-- Turns a Help toggle button's IsChecked into Visible / Collapsed. -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!-- The help box above an editor. -->
        <Style x:Key="EditorHelpBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF4F6FA" />
            <Setter Property="BorderBrush" Value="#FFB8C2D6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Section headers. -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Red error text shown under an editor when it has soft errors. -->
        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftErrorTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="MaxHeight" Value="120" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <!--
            The clipboard buttons. A custom template is used so that the "used" and "error"
            colors always show (the default Windows button template ignores Background on hover).
            Used buttons stay clickable on purpose: Ctrl+click has to reach them to re-enable them.
        -->
        <!-- Button size and text size. Changed from code when switching between Setup and Action mode. -->
        <sys:Double x:Key="ClipboardButtonMinHeight">0</sys:Double>
        <sys:Double x:Key="ClipboardButtonFontSize">13</sys:Double>

        <!-- Buttons stacked under each other (Setup mode, and Action mode with a fixed height). -->
        <ItemsPanelTemplate x:Key="StackedButtonsPanel">
            <StackPanel />
        </ItemsPanelTemplate>

        <!-- Buttons sharing the available height equally (Action mode with "fill"). -->
        <ItemsPanelTemplate x:Key="FillButtonsPanel">
            <UniformGrid Columns="1" />
        </ItemsPanelTemplate>

        <Style x:Key="ClipboardButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="MinHeight" Value="{DynamicResource ClipboardButtonMinHeight}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#FFF4F6FA" />
            <Setter Property="BorderBrush" Value="#FFB8C2D6" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#FF3B6FD8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFDCE6FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Soft error: light red background. -->
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SoftErrorBrush}" />
                </DataTrigger>
                <!-- Already copied: greyed out so it looks disabled. -->
                <DataTrigger Binding="{Binding IsUsed}" Value="True">
                    <Setter Property="Background" Value="#FFE6E6E6" />
                    <Setter Property="Foreground" Value="#FF9A9A9A" />
                    <Setter Property="BorderBrush" Value="#FFD0D0D0" />
                    <Setter Property="Cursor" Value="Arrow" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu: each setup is one JSON file. -->
        <Menu DockPanel.Dock="Top" Padding="2">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="NewMenuItem_Click" />
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="OpenMenuItem_Click" />
                <MenuItem x:Name="RecentFilesMenuItem" Header="Open _recent" />
                <Separator />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveMenuItem_Click" />
                <MenuItem Header="Save _as..." InputGestureText="Ctrl+Shift+S" Click="SaveAsMenuItem_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <!-- Presets for the Action mode buttons. Exact numbers can also be typed into the setup file. -->
                <MenuItem Header="Action _buttons">
                    <MenuItem x:Name="NormalButtonsMenuItem" Header="_Normal" IsCheckable="True" Click="ActionButtonSizeMenuItem_Click" Tag="normal" />
                    <MenuItem x:Name="LargeButtonsMenuItem" Header="_Large" IsCheckable="True" Click="ActionButtonSizeMenuItem_Click" Tag="large" />
                    <MenuItem x:Name="ExtraLargeButtonsMenuItem" Header="_Extra large" IsCheckable="True" Click="ActionButtonSizeMenuItem_Click" Tag="extralarge" />
                    <MenuItem x:Name="FillButtonsMenuItem" Header="_Fill the window" IsCheckable="True" Click="ActionButtonSizeMenuItem_Click" Tag="fill" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Quick guide" InputGestureText="F1" Click="QuickGuideMenuItem_Click" />
                <MenuItem Header="_About Paster" Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>

        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Background="#FFF0F0F0" BorderBrush="#FFD0D0D0" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="True">
                <!-- Keeps the window above all other windows. Remembered on this computer. -->
                <CheckBox x:Name="AlwaysOnTopCheckBox" DockPanel.Dock="Right" Content="Always on top"
                          VerticalAlignment="Center" Margin="0,0,12,0"
                          Checked="AlwaysOnTopCheckBox_Changed" Unchecked="AlwaysOnTopCheckBox_Changed"
                          ToolTip="Keep Paster above other windows so it doesn't get hidden" />
                <!-- Off: a click copies and greys the button out. On: buttons stay clickable, Ctrl+click toggles the grey. -->
                <CheckBox x:Name="KeepActiveCheckBox" DockPanel.Dock="Right" Content="Keep buttons active"
                          VerticalAlignment="Center" Margin="0,0,12,0"
                          Checked="KeepActiveCheckBox_Changed" Unchecked="KeepActiveCheckBox_Changed"
                          ToolTip="On: every click copies and the button stays clickable. Ctrl+click copies and greys it out (or back).&#x0a;Off: a click copies and greys the button out; Ctrl+click makes it clickable again." />
                <!-- Counts every copy. Ctrl+click -1, Alt+click reset to 0, Shift+click type a number. -->
                <Button x:Name="ClickCounterButton" DockPanel.Dock="Right" Content="Count: 0" Padding="10,2" Margin="0,0,12,0"
                        MinWidth="80" FontWeight="SemiBold"
                        Click="ClickCounterButton_Click"
                        ToolTip="Goes up by 1 for every copy.&#x0a;Ctrl+click: minus 1.  Alt+click: reset to 0.  Shift+click: set the number." />
                <!-- Mode switch: Setup shows the editors, Action shows only the tables and buttons. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0">
                    <RadioButton x:Name="SetupModeRadioButton" GroupName="Mode" Content="Setup" Padding="14,3"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Checked="ModeRadioButton_Checked"
                                 ToolTip="Edit the table list, variables, joiners and button templates" />
                    <RadioButton x:Name="ActionModeRadioButton" GroupName="Mode" Content="Action" Padding="14,3"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Checked="ModeRadioButton_Checked"
                                 ToolTip="Hide the editors and just use the buttons" />
                </StackPanel>
                <!-- Walk order, only shown when the setup has layers. Part of the setup file. -->
                <StackPanel x:Name="WalkOrderPanel" DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0" Visibility="Collapsed">
                    <TextBlock Text="Order:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FF505050" />
                    <RadioButton x:Name="ByLayerRadioButton" GroupName="WalkOrder" Content="By layer" Padding="10,3"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Checked="WalkOrderRadioButton_Checked"
                                 ToolTip="Every table in the first layer, then every table in the next layer, and so on" />
                    <RadioButton x:Name="ByTableRadioButton" GroupName="WalkOrder" Content="By table" Padding="10,3"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Checked="WalkOrderRadioButton_Checked"
                                 ToolTip="The first table through every layer, then the next table, and so on" />
                </StackPanel>
                <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Foreground="#FF505050"
                           TextTrimming="CharacterEllipsis"
                           Text="Click a button to copy. Ctrl+click a greyed-out button to enable it again." />
            </DockPanel>
        </Border>

        <!-- Bottom: action log, only shown in Action mode. -->
        <Border x:Name="ActionLogPanel" DockPanel.Dock="Bottom" Height="160" Visibility="Collapsed"
                BorderBrush="#FFD0D0D0" BorderThickness="0,1,0,0" Padding="8,6">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Open log folder" Padding="10,2" Click="OpenLogFolderButton_Click"
                            ToolTip="Show the daily log files in Explorer" />
                    <Button DockPanel.Dock="Right" Content="Clear" Padding="10,2" Margin="0,0,6,0" Click="ClearLogButton_Click"
                            ToolTip="Clear this list (the log files are kept)" />
                    <Button DockPanel.Dock="Right" Content="Export..." Padding="10,2" Margin="0,0,6,0" Click="ExportLogButton_Click"
                            ToolTip="Save the entries in this list to a text file (tab-separated, opens in Excel)" />
                    <TextBlock Text="Action log" Style="{StaticResource HeaderTextStyle}" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="ActionLogListBox" FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="120" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition x:Name="SetupSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="SetupColumn" Width="420" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Left: the tables, or the steps (table · layer) when layers are used -->
            <DockPanel Grid.Column="0">
                <TextBlock x:Name="StepListHeader" DockPanel.Dock="Top" Text="Tables" Style="{StaticResource HeaderTextStyle}" />
                <ListBox x:Name="StepListBox" SelectionChanged="StepListBox_SelectionChanged"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,3" />
                            <Setter Property="ToolTip" Value="{Binding ErrorText}" />
                            <Style.Triggers>
                                <!-- Every button copied: the row is greyed out. -->
                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                    <Setter Property="Foreground" Value="#FF9A9A9A" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SoftErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Foreground="#FF808080" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding StepName}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Middle: buttons for the selected table / step -->
            <DockPanel Grid.Column="2">
                <TextBlock x:Name="SelectedTableHeader" DockPanel.Dock="Top" Text="Buttons" Style="{StaticResource HeaderTextStyle}" />

                <!-- Progress over all tables / steps: copied buttons out of all buttons, plus the reset buttons. -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Reset all" Padding="10,2" Margin="6,0,0,0"
                            Click="ResetAllButton_Click"
                            ToolTip="Make every button everywhere clickable again" />
                    <Button x:Name="ResetStepButton" DockPanel.Dock="Right" Content="Reset table" Padding="10,2" Margin="6,0,0,0"
                            Click="ResetStepButton_Click"
                            ToolTip="Make every button in the selected row clickable again" />
                    <TextBlock x:Name="OverallProgressText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="#FF505050" Text="0 / 0" />
                    <ProgressBar x:Name="OverallProgressBar" Height="14" Minimum="0" Maximum="1" Value="0"
                                 ToolTip="Copied buttons out of all buttons, over the whole list" />
                </DockPanel>

                <ScrollViewer x:Name="ButtonScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ButtonItemsControl" ItemsPanel="{StaticResource StackedButtonsPanel}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ClipboardButtonStyle}"
                                        Click="ClipboardButton_Click"
                                        ToolTipService.InitialShowDelay="300"
                                        ToolTipService.ShowDuration="60000">
                                    <!-- Hover: the full text that will be copied (handy for labelled multi-line buttons). -->
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{Binding ToolTipText}" FontFamily="Consolas" FontSize="13"
                                                       TextWrapping="Wrap" MaxWidth="900" />
                                        </ToolTip>
                                    </Button.ToolTip>
                                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontFamily="Consolas"
                                               FontSize="{DynamicResource ClipboardButtonFontSize}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter x:Name="SetupGridSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right: setup editors, one tab each. Every keystroke updates the buttons immediately. -->
            <TabControl x:Name="SetupPanel" Grid.Column="4">
                <TabItem x:Name="TablesTab" Header="Tables">
                    <DockPanel Margin="0,6,0,0">
                        <!-- Format hint, Help and Insert example. -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <ToggleButton x:Name="TablesHelpToggle" DockPanel.Dock="Right" Content="Help" Padding="10,2"
                                          ToolTip="Show what you can write in this box" />
                            <Button x:Name="TablesExampleButton" DockPanel.Dock="Right" Content="Insert example" Padding="10,2" Margin="0,0,6,0"
                                    Click="InsertExampleButton_Click"
                                    ToolTip="Fill this box with example lines (only while it has nothing but comments)" />
                            <TextBlock Text="Name; var=value; layers=a,b" VerticalAlignment="Center" Foreground="#FF606060"
                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <!-- Help text, shown while the Help button is pressed in. -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource EditorHelpBorderStyle}"
                                Visibility="{Binding IsChecked, ElementName=TablesHelpToggle, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock TextWrapping="Wrap">
                                <Bold>One table per line.</Bold> The name is available in templates as {table}.
                                <LineBreak /><LineBreak />
                                After a <Run FontFamily="Consolas">;</Run> you can set variables for this line only. They win over everything else:<LineBreak /><Run FontFamily="Consolas">Customer; schema=stg; prefix=Fact</Run>
                                <LineBreak /><LineBreak />
                                With layers, <Run FontFamily="Consolas">layers=stg,wrk</Run> limits the table to those layers.
                                <LineBreak /><LineBreak />
                                Lines starting with // are comments.
                            </TextBlock>
                        </Border>
                        <TextBlock x:Name="TablesErrorText" DockPanel.Dock="Bottom" Style="{StaticResource ErrorTextStyle}" />
                        <TextBox x:Name="TablesTextBox" Style="{StaticResource EditorTextBoxStyle}" TextChanged="SetupEditor_TextChanged" />
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="LayersTab" Header="Layers">
                    <DockPanel Margin="0,6,0,0">
                        <!-- Format hint, Help and Insert example. -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <ToggleButton x:Name="LayersHelpToggle" DockPanel.Dock="Right" Content="Help" Padding="10,2"
                                          ToolTip="Show what you can write in this box" />
                            <Button x:Name="LayersExampleButton" DockPanel.Dock="Right" Content="Insert example" Padding="10,2" Margin="0,0,6,0"
                                    Click="InsertExampleButton_Click"
                                    ToolTip="Fill this box with example lines (only while it has nothing but comments)" />
                            <TextBlock Text="name; var=value   (optional)" VerticalAlignment="Center" Foreground="#FF606060"
                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <!-- Help text, shown while the Help button is pressed in. -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource EditorHelpBorderStyle}"
                                Visibility="{Binding IsChecked, ElementName=LayersHelpToggle, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock TextWrapping="Wrap">
                                <Bold>Optional.</Bold> List the layers every table goes through, in order (stg, wrk, dwh...). Leave the box empty to work with plain tables.
                                <LineBreak /><LineBreak />
                                Each table then becomes one step per layer, like "DBTable · wrk". The layer name is available as {layer}.
                                <LineBreak /><LineBreak />
                                Variables after a <Run FontFamily="Consolas">;</Run> apply in that layer only:<LineBreak /><Run FontFamily="Consolas">dwh; schema=dwh; prefix=Dim_</Run>
                                <LineBreak /><LineBreak />
                                Order in the top bar walks the steps By layer or By table.
                            </TextBlock>
                        </Border>
                        <TextBlock x:Name="LayersErrorText" DockPanel.Dock="Bottom" Style="{StaticResource ErrorTextStyle}" />
                        <TextBox x:Name="LayersTextBox" Style="{StaticResource EditorTextBoxStyle}" TextChanged="SetupEditor_TextChanged" />
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="VariablesTab" Header="Variables">
                    <DockPanel Margin="0,6,0,0">
                        <!-- Format hint, Help and Insert example. -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <ToggleButton x:Name="VariablesHelpToggle" DockPanel.Dock="Right" Content="Help" Padding="10,2"
                                          ToolTip="Show what you can write in this box" />
                            <Button x:Name="VariablesExampleButton" DockPanel.Dock="Right" Content="Insert example" Padding="10,2" Margin="0,0,6,0"
                                    Click="InsertExampleButton_Click"
                                    ToolTip="Fill this box with example lines (only while it has nothing but comments)" />
                            <TextBlock Text="name=value" VerticalAlignment="Center" Foreground="#FF606060"
                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <!-- Help text, shown while the Help button is pressed in. -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource EditorHelpBorderStyle}"
                                Visibility="{Binding IsChecked, ElementName=VariablesHelpToggle, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock TextWrapping="Wrap">
                                <Bold>One name=value per line.</Bold> Used for every table, unless a table line or a layer sets its own value.
                                <LineBreak /><LineBreak />
                                <Run FontFamily="Consolas">schema=wrk</Run><LineBreak /><Run FontFamily="Consolas">prefix=</Run>   (an empty value is fine)
                                <LineBreak /><LineBreak />
                                Names start with a letter or _, then letters, digits or _. {table} and {layer} are built in.
                            </TextBlock>
                        </Border>
                        <TextBlock x:Name="VariablesErrorText" DockPanel.Dock="Bottom" Style="{StaticResource ErrorTextStyle}" />
                        <TextBox x:Name="VariablesTextBox" Style="{StaticResource EditorTextBoxStyle}" TextChanged="SetupEditor_TextChanged" />
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="JoinersTab" Header="Joiners">
                    <DockPanel Margin="0,6,0,0">
                        <!-- Format hint, Help and Insert example. -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <ToggleButton x:Name="JoinersHelpToggle" DockPanel.Dock="Right" Content="Help" Padding="10,2"
                                          ToolTip="Show what you can write in this box" />
                            <Button x:Name="JoinersExampleButton" DockPanel.Dock="Right" Content="Insert example" Padding="10,2" Margin="0,0,6,0"
                                    Click="InsertExampleButton_Click"
                                    ToolTip="Fill this box with example lines (only while it has nothing but comments)" />
                            <TextBlock Text="name=template with {variables}" VerticalAlignment="Center" Foreground="#FF606060"
                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <!-- Help text, shown while the Help button is pressed in. -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource EditorHelpBorderStyle}"
                                Visibility="{Binding IsChecked, ElementName=JoinersHelpToggle, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock TextWrapping="Wrap">
                                <Bold>New variables built from other variables</Bold>, one name=template per line:
                                <LineBreak /><LineBreak />
                                <Run FontFamily="Consolas">fulltable={prefix}{table}{suffix}</Run><LineBreak /><Run FontFamily="Consolas">fullname=[{database}].[{schema}].[{fulltable}]</Run>
                                <LineBreak /><LineBreak />
                                A joiner can use other joiners. If two joiners use each other in a loop, the box turns red.
                            </TextBlock>
                        </Border>
                        <TextBlock x:Name="JoinersErrorText" DockPanel.Dock="Bottom" Style="{StaticResource ErrorTextStyle}" />
                        <TextBox x:Name="JoinersTextBox" Style="{StaticResource EditorTextBoxStyle}" TextChanged="SetupEditor_TextChanged" />
                    </DockPanel>
                </TabItem>
                <TabItem x:Name="ButtonsTab" Header="Buttons">
                    <DockPanel Margin="0,6,0,0">
                        <!-- Format hint, Help and Insert example. -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <ToggleButton x:Name="ButtonsHelpToggle" DockPanel.Dock="Right" Content="Help" Padding="10,2"
                                          ToolTip="Show what you can write in this box" />
                            <Button x:Name="ButtonsExampleButton" DockPanel.Dock="Right" Content="Insert example" Padding="10,2" Margin="0,0,6,0"
                                    Click="InsertExampleButton_Click"
                                    ToolTip="Fill this box with example lines (only while it has nothing but comments)" />
                            <TextBlock Text="one template per line, @layer to limit" VerticalAlignment="Center" Foreground="#FF606060"
                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <!-- Help text, shown while the Help button is pressed in. -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource EditorHelpBorderStyle}"
                                Visibility="{Binding IsChecked, ElementName=ButtonsHelpToggle, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock TextWrapping="Wrap">
                                <Bold>One button per line.</Bold> Write the text to copy with {tokens} in it:
                                <LineBreak /><LineBreak />
                                <Run FontFamily="Consolas">TRUNCATE TABLE [{schema}].[{fulltable}];</Run>
                                <LineBreak /><LineBreak />
                                Transforms: {table:upper}, lower, trim, pascal, camel, snake, kebab, title. Chain them: {table:snake:upper}. {{ and }} give a literal { or }.
                                <LineBreak /><LineBreak />
                                Multi-line button: a line with &lt;&lt;&lt; and a label, the lines to copy, then a line with only &gt;&gt;&gt;. Hover the button to see the full text.
                                <LineBreak /><LineBreak />
                                With layers, start a line with @ and layer names to show it in those layers only:<LineBreak /><Run FontFamily="Consolas">@stg Import {table} with SSIS</Run>
                            </TextBlock>
                        </Border>
                        <TextBlock x:Name="ButtonsErrorText" DockPanel.Dock="Bottom" Style="{StaticResource ErrorTextStyle}" />
                        <TextBox x:Name="ButtonsTextBox" Style="{StaticResource EditorTextBoxStyle}" TextChanged="SetupEditor_TextChanged" />
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
